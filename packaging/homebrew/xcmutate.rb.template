# Homebrew formula of xcmutate. Generated by scripts/make-formula.sh from packaging/homebrew/xcmutate.rb.template:
# edit the template, not the generated file.
class Xcmutate < Formula
  desc "Diff-driven mutation testing for Swift and Xcode projects"
  homepage "https://github.com/@@OWNER@@/xcmutate"
  url "https://github.com/@@OWNER@@/xcmutate/releases/download/v@@VERSION@@/xcmutate-@@VERSION@@-macos-universal.tar.gz"
  sha256 "@@SHA256@@"
  license "MIT"

  # `brew install --HEAD xcmutate` builds from the sources (several minutes: swift-syntax).
  # It needs Swift 6.3 or newer; checked with Xcode 26.6 and 27.2.
  head do
    url "https://github.com/@@OWNER@@/xcmutate.git", branch: "main"
    depends_on xcode: ["26.6", :build]
  end

  depends_on :macos
  # At run time the tool calls xcodebuild and swiftc
  depends_on :xcode

  def install
    if build.head?
      system "swift", "build", "--disable-sandbox", "-c", "release", "--product", "xcmutate"
      bin.install ".build/release/xcmutate"
    else
      bin.install "xcmutate"
    end
    doc.install "LICENSE", "THIRD_PARTY_NOTICES.md" if File.exist?("THIRD_PARTY_NOTICES.md")
  end

  def caveats
    <<~EOS
      xcmutate runs xcodebuild and swiftc: it needs Xcode (not only the Command Line Tools),
      selected with xcode-select.
    EOS
  end

  test do
    # A HEAD build prints the version of its sources, not "HEAD-<commit>"
    expected = version.head? ? /^\d+\.\d+\.\d+$/ : version.to_s
    assert_match expected, shell_output("#{bin}/xcmutate --version")
    (testpath/"A.swift").write <<~SWIFT
      func isAdult(_ age: Int) -> Bool { age >= 18 }
    SWIFT
    assert_match "boundary", shell_output("#{bin}/xcmutate list --root #{testpath} A.swift")
  end
end
